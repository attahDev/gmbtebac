// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

// prisma/schema.prisma

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  firstname        String
  lastname         String
  organization     String?
  role             UserRole? // 👈 Uses enum now!
  // Free-text region, e.g. "Greater Manchester" — shown on the profile page.
  // No phone field: phone numbers aren't collected here, they come through
  // the mentee log instead.
  region             String?
  profileVisibility  ProfileVisibility @default(PUBLIC)
  isVerified       Boolean   @default(false)
  // Admin deactivation switch — enforced in JwtStrategy so revoking access
  // takes effect immediately rather than waiting for the token to expire
  // (same reasoning as RolesGuard's role check).
  isActive         Boolean   @default(true)
  agreedToTerms    Boolean   @default(false)
  subscribedToNews Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  otps                 Otp[]
  refreshTokens        RefreshToken[]
  verificationSessions VerificationSession[]
  mentorChats          MentorChat[]
  businessPlans        BusinessPlan[]
  comments Comment[]

  brandAssets          BrandAsset[]
  chatSessions         ChatSession[]

  mentorConnections     MentorConnection[]
  mentorProfile         Mentor?
  menteeMessages        MenteeMessage[]
  courseProgress        CourseProgress[]
  eventAttendance       EventAttendance[]
  createdEvents         Event[]
  createdNewsArticles   NewsArticle[]
  newsComments          NewsComment[]
  userBadges            UserBadge[]
  activityLogs          ActivityLog[]
  tributes              Tribute[]
  nominations           Nomination[]
  spotlightStories      SpotlightStory[]
  moduleProgress        ModuleProgress[]
  greenActions          GreenAction[]
  greenProjectSupport   GreenProjectSupport[]
  spotlightLikes        SpotlightLike[]
  creditTransactions    CreditTransaction[]
  notifications         Notification[]
  skillLogs             SkillLog[]
  careerGoal            MenteeCareerGoal?
  certificates          Certificate[]

  @@map("users")
}

enum UserRole {
  STUDENT
  PROFESSIONAL
  ENGINEER
  MENTOR
  ADMIN
  OTHER
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

model Otp {
  id        String   @id @default(uuid())
  code      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  useCase   UseCase

  createdAt DateTime @default(now())

  @@map("otps")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isRevoked Boolean  @default(false)

  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model VerificationSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime

  @@map("verification_sessions")
}

enum UseCase {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model NewsletterSubscription {
  id        String  @id @default(uuid())
  firstName String
  email     String  @unique
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())

  @@map("newsletter_subscriptions")
}

model PartnerRequest {
  id               String  @id @default(uuid())
  fullName         String
  organizationName String
  email            String
  message          String
  wantsSponsorship Boolean @default(false)

  status PartnerRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("partner_requests")
}

enum PartnerRequestStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
}

model ContactMessage {
  id               String  @id @default(uuid())
  fullName         String
  email            String
  subject          String
  message          String
  wantsPartnership Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

model MentorChat {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages MentorMessage[]

  @@map("mentor_chats")
}

model MentorMessage {
  id     String     @id @default(uuid())
  chatId String
  chat   MentorChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  role    MentorMessageRole
  content String

  createdAt DateTime @default(now())

  @@map("mentor_messages")
}

enum MentorMessageRole {
  USER
  ASSISTANT
}

model BusinessPlan {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessIdea    String
  industry        String
  targetAudience  String
  skills          String
  budget          String
  location        String
  experienceLevel String
  goal            String

  // References Idea.id from the idea-engine service's own `ideas` table.
  // No DB-level FK — idea-engine owns a separate table in the same Postgres
  // instance, same pattern as the credit-gating tables it already reads/writes.
  sourceIdeaId String?

  aiResponse Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("business_plans")
}

enum BrandAssetType {
  LOGO
  BUSINESS_CARD
  LETTERHEAD
  EMAIL_SIGNATURE
  INVOICE
  QUOTATION
  COMPANY_PROFILE
  CAPABILITY_STATEMENT
  BRAND_GUIDELINES
}

enum BrandAssetStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model BrandAsset {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  externalAssetId String? @unique
  jobId           String?

  assetType BrandAssetType
  status    BrandAssetStatus @default(PENDING)

  version       Int     @default(1)
  parentAssetId String?

  inputsSnapshot Json
  aiContent      Json?
  rawResponse    Json?

  pdfUrl            String?
  docxUrl           String?
  pngUrl            String?
  svgLightUrl       String?
  svgDarkUrl        String?
  pngTransparentUrl String?

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([assetType])
  @@index([status])
  @@map("brand_assets")
}


model ChatSession {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  visitorType ChatVisitorType @default(UNKNOWN)
  status      ChatSessionStatus @default(OPEN)

  title String?

  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([visitorType])
  @@index([status])
  @@map("chat_sessions")
}

model ChatMessage {
  id String @id @default(uuid())

  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  sender  ChatSender
  content String

  aiStatus   String?
  aiRawReply Json?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@map("chat_messages")
}

enum ChatVisitorType {
  STUDENT
  MENTOR
  PARTNER
  UNKNOWN
}

enum ChatSessionStatus {
  OPEN
  CLOSED
  ESCALATED
}

enum ChatSender {
  USER
  BOT
}
// ---------------------------------------------------------------------------
// Engagement models — mentors, opportunities, courses, events, badges,
// activity feed, community spotlight. Added to back the Student Dashboard,
// which previously rendered hardcoded numbers with no backing data.
// ---------------------------------------------------------------------------

model Mentor {
  id        String  @id @default(uuid())
  name      String
  role      String
  company   String?
  avatarUrl String?
  bio       String?
  skills    String[]
  isActive  Boolean @default(true)

  // Academy Schools this mentor is authorised to review certification
  // projects for (e.g. "aws", "microsoft"). Free text, matches Course.school.
  // Empty array = unrestricted: can review any School's project — this is
  // the default so existing mentors keep working until an admin opts them
  // into a restriction. Deliberately not an enum, same reasoning as `category`.
  schools String[] @default([])

  // Admin-assigned grouping used to sort/filter the mentor directory
  // (e.g. "Engineering", "Design", "Product"). Free text on purpose —
  // no fixed enum — so admins aren't blocked waiting on a code change
  // to add a new category.
  category String @default("General")

  // Nullable: older/seed directory rows may still have no linked login.
  // When set, this Mentor IS a real User (role: MENTOR) who can log in
  // and see their own "My Mentees" dashboard.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connections MentorConnection[]
  spotlights  MentorSpotlight[]

  @@index([isActive])
  @@map("mentors")
}

enum MentorConnectionStatus {
  PENDING
  ACTIVE
  COMPLETED
  DECLINED
}

model MentorConnection {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentorId String
  mentor   Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  status            MentorConnectionStatus @default(PENDING)
  sessionsCompleted Int                    @default(0)
  nextSessionAt     DateTime?

  messages  MenteeMessage[]
  sessions  MentorSession[]
  skillLogs SkillLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, mentorId])
  @@index([userId])
  @@map("mentor_connections")
}

/** Direct mentor <-> mentee messaging within a connection (distinct from
 *  MentorChat/MentorMessage, which back the AI mentor assistant). */
model MenteeMessage {
  id           String           @id @default(uuid())
  connectionId String
  connection   MentorConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content String

  createdAt DateTime @default(now())

  @@index([connectionId])
  @@map("mentee_messages")
}

model Opportunity {
  id          String   @id @default(uuid())

  title       String
  description String?

  company     String

  category    String?
  location    String?
  type        String?

  // Filters this opportunity to holders of a specific Academy certification
  // (matches Course.school, e.g. "aws"). Null = open to everyone, same
  // "unrestricted by default" pattern as Mentor.schools.
  requiredSchool String?

  source      String   @default("MANUAL")

  provider    String?
  externalId  String?

  url         String?
  applyUrl    String?

  isFeatured  Boolean  @default(false)
  isActive    Boolean  @default(true)

  postedAt    DateTime @default(now())

  @@unique([provider, externalId], name: "provider_externalId")

  @@index([category])
  @@index([requiredSchool])
  @@index([isFeatured])
  @@index([isActive])

  @@map("opportunities")
}

model Course {
  id          String  @id @default(uuid())
  // Stable, human-readable identifier used in frontend URLs
  // (/dashboard/green-impact/:courseSlug). Generated from title on create.
  slug        String  @unique
  title       String
  description String?
  category    String?
  // Which Academy "School" this course belongs to (e.g. "microsoft",
  // "aws", "google-cloud", "nvidia", "salesforce", "data-science",
  // "research", "startup", "investor", "business"). Null/unused for
  // non-Academy categories like "climate". Free-form string (not an enum)
  // so a new School can be added via content/config alone.
  school      String?
  // Free-form sub-tags for sorting/filtering WITHIN a category — e.g.
  // ["Web Development", "Beginner"] on an education course, or
  // ["Energy", "Certification"] on a climate one. Separate from `category`,
  // which only ever holds "education" | "climate" and decides which page
  // (Academy vs Green Impact) the course shows up on at all.
  tags        String[] @default([])
  // Admin-curated spotlight — lets you run 300 courses but only surface a
  // handful on the toolkit landing pages, same mechanism as Event.isFeatured.
  isFeatured  Boolean  @default(false)
  // Extra display fields that used to live hardcoded in
  // sustainabilityCourses.ts (image, duration, contactHours, mode, level,
  // certificateAvailable, learningOutcomes, shortDescription). Kept as JSON
  // instead of a wall of nullable columns since it's display metadata, not
  // relational data — same reasoning as Module.content.
  metadata Json?
  // NOTE: totalModules is now a DENORMALIZED CACHE, kept in sync by the
  // modules service whenever a Module is created/deleted for this course.
  // The source of truth is COUNT(modules). Never set this by hand — it
  // exists so list views don't need a join/count on every request.
  totalModules Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress     CourseProgress[]
  modules      Module[]
  certificates Certificate[]

  @@index([isActive])
  @@index([school])
  @@map("courses")
}

model Module {
  id       String @id @default(uuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Stable identifier for /dashboard/green-impact/:courseSlug/:lessonSlug.
  // Unique per-course (not globally), generated from title on create.
  slug    String
  title   String
  // Rich content — store structured JSON (sections/paragraphs/media) so the
  // frontend can render it the same way it rendered the old hardcoded
  // sustainabilityCourses.ts data, just sourced from the DB instead.
  content Json
  order   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress ModuleProgress[]

  @@unique([courseId, slug])
  @@index([courseId])
  @@index([courseId, order])
  @@map("modules")
}

model ModuleProgress {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  // Section ids the user has checked "done" — validated against
  // Module.content.sections[].id when toggled, not enforced at the DB
  // level (Postgres text[] can't foreign-key into JSON).
  completedSectionIds String[] @default([])
  isCompleted         Boolean  @default(false)
  completedAt         DateTime?
  // Keyed by the quiz section's id (see ModuleSectionDto type: 'quiz').
  // { [sectionId]: { score, total, passed, attemptedAt } } — lets a module
  // hold a quiz section without a separate Quiz/QuizAttempt table.
  quizScores          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, moduleId])
  @@index([userId])
  @@map("module_progress")
}

model Certificate {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Short, guessable-resistant code printed on the PDF and used for the
  // public /verify/:code lookup — not the same as `id` so we're free to
  // reissue/regenerate the PDF later without invalidating the code.
  verificationCode String  @unique @default(uuid())
  pdfUrl           String?
  issuedByUserId   String

  issuedAt DateTime @default(now())

  @@index([userId])
  @@index([courseId])
  @@map("certificates")
}

model GreenProject {
  id          String @id @default(uuid())
  title       String
  description String
  imageUrl    String?

  goalAmountMinor   Int
  raisedAmountMinor Int     @default(0)
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supporters GreenProjectSupport[]

  @@map("green_projects")
}

model GreenProjectSupport {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   GreenProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, projectId])
  @@map("green_project_support")
}

model CreditListing {
  id                String   @id @default(uuid())
  title             String
  description       String?
  pointsPerCredit   Float
  availableQuantity Int      @default(0)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions CreditTransaction[]

  @@map("credit_listings")
}

model CreditTransaction {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  listingId String
  listing   CreditListing @relation(fields: [listingId], references: [id])

  type        String // BUY | SELL
  quantity    Int
  pointsDelta Float

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([listingId])
  @@map("credit_transactions")
}

model ClimateReport {
  id          String  @id @default(uuid())
  title       String
  description String?
  link        String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("climate_reports")
}

model GreenAction {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        String
  description String?
  co2OffsetKg Float
  area        String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("green_actions")
}

model CourseProgress {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  completedModules Int     @default(0)
  isCompleted      Boolean @default(false)

  // ── Certification journey, past "all modules done" ──
  // Practical project submission (a link/file the student submits once
  // modules + quizzes are complete).
  projectSubmissionUrl String?
  projectSubmittedAt   DateTime?
  // Set by whichever Mentor reviews the submission — nullable until then.
  // Kept as a plain userId (not a relation) to avoid a second FK cycle on
  // User; the mentors module already resolves userId -> Mentor elsewhere.
  reviewedByUserId      String?
  mentorFeedback        String?
  certificateStatus      CertificateStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@map("course_progress")
}

enum CertificateStatus {
  NOT_STARTED
  IN_PROGRESS       // modules in progress
  QUIZZES_PASSED     // all module quizzes passed, project not yet submitted
  PROJECT_SUBMITTED  // awaiting mentor review
  CHANGES_REQUESTED  // mentor sent it back
  CERTIFIED          // mentor approved, Certificate issued
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String?
  location    String?
  imageUrl    String?
  // 'Virtual' | 'In-Person' | 'Hybrid' — free-form like Course.category
  // rather than an enum, so the admin event form can add new modes without
  // a migration. Frontend badges default to 'In-Person' when unset.
  mode        String?
  // Optional external URL — registration page, Zoom/Meet link, Eventbrite,
  // etc. Purely optional so events with no online component (walk-in
  // workshops) don't need one.
  link        String?
  startsAt    DateTime
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  // Featured events are pinned first in findUpcoming(), ahead of anything
  // sorted purely by date — lets an admin put one event front-and-centre
  // on the dashboard regardless of how soon it is.
  isFeatured  Boolean   @default(false)
  // Admin manually ticks an event off as done — distinct from isActive
  // (soft-delete/hide). A completed event stays visible in the full
  // events archive ("View All Events") but drops out of the upcoming
  // list even if its date logic would otherwise still show it.
  isCompleted Boolean   @default(false)
  // Free-form chips shown on the public Events page cards (e.g. "AI/ML",
  // "Networking") — same convention as Course.tags.
  tags        String[]  @default([])

  // ADMIN = official GMBTE-curated events (created via the admin panel).
  // USER  = submitted by a member through "Host an Event" on the dashboard.
  source       EventSource @default(ADMIN)
  // Reuses the same PENDING/APPROVED/REJECTED moderation flow as
  // SpotlightStory. Admin-created events skip the queue entirely
  // (default APPROVED); user submissions start PENDING and only become
  // publicly visible once an admin approves them — see findUpcoming/findAll.
  reviewStatus PostStatus  @default(APPROVED)

  // GENERAL = shown on the main GMBTE Events page/dashboard (gmbtefro).
  // HALL_OF_FAME = shown on the Hall of Fame site's Events page (hofgmbte)
  // instead — induction ceremonies, regional recognition, legacy events.
  // A real enum (not a tag) because it gates which frontend's public
  // listing an event appears in, same reasoning as source/reviewStatus
  // above — not open-ended like mode/tags.
  audience EventAudience @default(GENERAL)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Populated by an admin after the event happens — powers the public "Our
  // Past Events / Highlights from Previous Editions" section. Shape:
  // { summary?: string, speakers?: string[], achievements?: string[],
  //   gallery?: string[] }. JSON rather than columns for the same reason
  // Course.metadata is JSON — flexible display content, not relational
  // data. Independent of isCompleted: an admin can prep a recap before
  // flipping isCompleted, or leave isCompleted events with no recap yet.
  recap Json?

  createdAt DateTime @default(now())

  attendees EventAttendance[]

  @@index([isActive])
  @@index([startsAt])
  @@index([reviewStatus])
  @@index([audience])
  @@map("events")
}

enum EventSource {
  ADMIN
  USER
}

enum EventAudience {
  GENERAL
  HALL_OF_FAME
}

model EventAttendance {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  status String @default("REGISTERED")

  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId])
  @@map("event_attendance")
}

// Admin-curated news/press articles — landing page teaser + the dedicated
// /news archive. Deliberately no submission/moderation flow like Event's
// USER source: "dropping articles" is an admin/content-team action, not a
// member-facing feature, so there's no EventSource-style split here.
model NewsArticle {
  id            String  @id @default(uuid())
  title         String
  // Short standfirst shown on cards (landing teaser + /news archive) and
  // as the fallback preview text wherever body/link aren't rendered.
  excerpt       String?
  coverImageUrl String?
  // In-platform body (rich text/markdown from the admin editor) — powers
  // the article's own /news/:id detail page. Nullable because an article
  // can instead just point out via externalLink below.
  body          String?
  // Outbound URL — press coverage, a partner's blog post, an external
  // publication, etc. When set (and body isn't), cards link straight out
  // instead of to a detail page. Enforcing "at least one of body/
  // externalLink" happens in NewsService, not here — Prisma has no
  // cross-column check constraint.
  externalLink  String?
  // Free-form chips, same convention as Event.tags / Course.tags.
  tags          String[] @default([])
  isActive      Boolean  @default(true)
  // Featured articles are pinned first on the landing teaser and the /news
  // archive, ahead of anything sorted purely by publishedAt — mirrors
  // Event.isFeatured.
  isFeatured    Boolean  @default(false)
  // Separate from createdAt so an article can be backdated/scheduled by
  // setting this explicitly, or left to default to "now" for same-day
  // drops. Public listings sort and filter on this, not createdAt.
  publishedAt   DateTime @default(now())

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  comments NewsComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([publishedAt])
  @@map("news_articles")
}

// Reader comments on a NewsArticle. Kept as its own table rather than
// reusing the existing Comment model (which is hard-wired to
// SpotlightStory via a required storyId) — separating the two avoids
// touching that model's existing shape/migrations for an unrelated
// feature.
model NewsComment {
  id String @id @default(uuid())

  articleId String
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  // Nullable: accounts/login aren't open to the public yet, so comments
  // need to work without one. userId is filled in when the poster does
  // happen to be logged in (auto-attributed, and only they can delete it
  // afterwards); otherwise authorName holds the guest display name they
  // typed in. Exactly one of the two is expected to be set — enforced in
  // NewsService, not here.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  authorName String?

  content String

  createdAt DateTime @default(now())

  @@index([articleId])
  @@map("news_comments")
}

model Badge {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  icon        String?

  metric String
  target Int

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId String
  badge   Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

model Tribute {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  message String

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("tributes")
}

model Nomination {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  nomineeName String
  category    String?
  story       String

  status     String    @default("PENDING")
  reviewedAt DateTime?

  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("nominations")
}
model ActivityLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  message String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

model SpotlightStory {
  id String @id @default(uuid())

  authorId String?
  author   User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  title       String
  description String

  authorName String
  authorRole String

  avatarColor String? @default("bg-red-600")
  imageUrl    String?

  status     PostStatus @default(PENDING)
  approvedAt DateTime?

  likes    Int @default(0)
  comments Int @default(0)

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())

  likedBy     SpotlightLike[]
  commentList Comment[]

  @@index([status])
  @@index([isPublished])
  @@index([status, approvedAt])
  @@map("spotlight_stories")
}


model Comment {
  id String @id @default(uuid())

  storyId String
  story SpotlightStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  content String

  createdAt DateTime @default(now())

  @@index([storyId])
  @@map("comments")
}

model SpotlightLike {
  id      String         @id @default(uuid())
  userId  String
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyId String
  story   SpotlightStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, storyId])
  @@index([storyId])
  @@map("spotlight_likes")
}

model Notification {
  id String @id @default(uuid())

  audience NotificationAudience

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category NotificationCategory
  title    String
  body     String?

  actionLabel String?
  actionUrl   String?
  metadata    Json?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([audience, userId])
  @@index([audience, isRead])
  @@map("notifications")
}

enum NotificationAudience {
  USER
  ADMIN
}

enum NotificationCategory {
  COMMUNITY
  EVENTS
  MENTORS
  OPPORTUNITIES
  COURSES
  GREEN_IMPACT
  SYSTEM
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Sessions, mentor spotlight, skill logging, and career paths — back
// mentors.service.ts and career-paths.service.ts.
// ---------------------------------------------------------------------------

enum SessionStatus {
  PENDING
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

model MentorSession {
  id           String           @id @default(uuid())
  connectionId String
  connection   MentorConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  proposedFor  DateTime
  scheduledFor DateTime?
  durationMins Int?
  agenda       String?
  status       SessionStatus @default(PENDING)
  mentorNotes  String?
  menteeNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skillLogs SkillLog[]

  @@index([connectionId])
  @@index([status])
  @@map("mentor_sessions")
}

model MentorSpotlight {
  id       String @id @default(uuid())
  mentorId String
  mentor   Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  shoutout  String
  isActive  Boolean  @default(true)
  startDate DateTime @default(now())
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([startDate])
  @@map("mentor_spotlights")
}

/** Mentee-reported skill, optionally tied to a specific session moment,
 *  optionally confirmed by the mentor on that connection. */
model SkillLog {
  id           String           @id @default(uuid())
  connectionId String
  connection   MentorConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      MentorSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  menteeId     String
  mentee       User             @relation(fields: [menteeId], references: [id], onDelete: Cascade)

  skillName         String
  notes             String?
  confirmedByMentor Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([connectionId])
  @@index([menteeId])
  @@index([sessionId])
  @@map("skill_logs")
}

model CareerPath {
  id          String  @id @default(uuid())
  title       String
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requiredSkills CareerPathSkill[]
  menteeGoals    MenteeCareerGoal[]

  @@map("career_paths")
}

model CareerPathSkill {
  id           String     @id @default(uuid())
  careerPathId String
  careerPath   CareerPath @relation(fields: [careerPathId], references: [id], onDelete: Cascade)

  skillName String
  weight    Int    @default(1)

  @@index([careerPathId])
  @@map("career_path_skills")
}

/** One active goal per mentee. aiSummary/aiSummaryAt/aiSummarySkillsCount cache
 *  the last AI gap-analysis so it only regenerates when logged-skill count changes. */
model MenteeCareerGoal {
  id           String     @id @default(uuid())
  menteeId     String     @unique
  mentee       User       @relation(fields: [menteeId], references: [id], onDelete: Cascade)
  careerPathId String
  careerPath   CareerPath @relation(fields: [careerPathId], references: [id])

  aiSummary            String?
  aiSummaryAt          DateTime?
  aiSummarySkillsCount Int?
  setAt                DateTime  @default(now())

  @@map("mentee_career_goals")
}
